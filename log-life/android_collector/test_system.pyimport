import subprocess
import time

print("\n===== BRATUHA LOG-LIFE SYSTEM CHECK =====\n")

path = os.getcwd()
print("Current folder:", path)

print("\n--- FILE CHECK ---")

files = [
    "collector.py",
    "collector_db.py",
    "life_log.txt",
    "life_log_encrypted.db",
    "secret.key"
]

for f in files:
    if os.path.exists(f):
        print(f, "✓ found")
    else:
        print(f, "✗ missing")

print("\n--- LOG CHECK ---")

if os.path.exists("life_log.txt"):
    with open("life_log.txt","r") as file:
        lines = file.readlines()
        print("Total log lines:", len(lines))
        print("Last 3 lines:")
        for l in lines[-3:]:
            print(l.strip())

print("\n--- ENCRYPTED DB SIZE ---")

if os.path.exists("life_log_encrypted.db"):
    size = os.path.getsize("life_log_encrypted.db")
    print("Encrypted DB size:", size, "bytes")

print("\n--- PROCESS CHECK ---")

try:
    ps = subprocess.check_output("ps aux | grep collector", shell=True).decode()
    print(ps)
except:
    print("Process check failed")

print("\n--- GIT SECURITY CHECK ---")

try:
    git = subprocess.check_output("git status", shell=True).decode()
    print(git)
except:
    print("Git not available in this folder")

print("\n===== CHECK COMPLETE =====\n")

